# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
bin/
# Anchored to the repository root so it cannot shadow a `bn` file or directory
# inside a module. A stray root-level `go build -o bn` used to leave a 27 MB
# untracked binary here that no pattern matched.
/bn
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/

# go.work IS tracked; go.work.sum is not. `go work sync` generates none for this
# workspace, but read commands such as `go list -m all` do — and an untracked
# file there aborts the deploy script's clean-worktree gate. Anchored so it
# cannot shadow a file of that name inside a module.
/go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Planning documents and review records: kept on disk, not tracked.
.agents/plans/
.agents/reviews/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
