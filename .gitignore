# Binaries for programs and plugins
bin/
.verification/
/target/
__pycache__/
# Anchored to the repository root so it cannot shadow a `bn` file or directory
# inside source or fixture directories.
/bn
*.exe
*.exe~
*.dll
*.so
*.dylib


# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/

# Built UI: ui/dist/ is a build output except the committed placeholder that
# lets Cargo embed something without Node.
ui/dist/*
!ui/dist/index.html
ui/node_modules/

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Agent working notes: kept on disk, not tracked.
.agents/plans/
.agents/reviews/
.agents/bead-swarm/history/
