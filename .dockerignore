# Docker reads .dockerignore from the build-context root, and the API image's
# context is now the repository root. This file carries the intent of the old
# apps/bean-counter/.dockerignore, widened to the monorepo.
.git
.github
.agents
.claude
.beads
**/.beads
**/.dolt
**/bin
# Not a blanket `frontend` exclusion: the UI image's context is still the
# frontend directory, and a root-level exclusion would be wrong the moment a
# second application ships a UI.
**/node_modules
**/frontend/dist
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/.env
**/.env.*
**/.envrc
**/.npmrc
**/.yarnrc*
**/.DS_Store
