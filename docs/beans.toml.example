# beans.toml — hub-wide configuration, committed at the root of the hub
# (~/.beans/hub/beans.toml). Every key is optional; omitted keys use the
# built-in defaults shown here.
#
# A project may override [workflow] in projects/<name>/beans.toml with the
# same keys; the merge is per key. BN_CONFIG=<file> replaces both.

[workflow]
# Ordered status vocabulary. Order drives display.
statuses = ["open", "in_progress", "ready_for_review", "ready_for_validation", "ready_for_merge", "blocked", "closed", "done"]
# Status assigned to newly created issues.
default = "open"
# Dispatchable statuses: returned by `bn ready`.
active = ["open"]
# Done statuses: satisfy blockers and are eligible for `bn archive`.
terminal = ["closed", "done"]
# Every other valid status is a hold state: not ready, not done.
#
# Optional: restrict legal moves. Accepted and validated, not yet enforced.
# [workflow.transitions]
# open = ["in_progress", "blocked", "closed"]

[types]
# Issue type vocabulary for `bn create -t`.
names = ["task", "bug", "feature", "epic", "chore"]

[ids]
# Length of the random hash in generated ids (<prefix>-<hash>).
length = 4

# --- projects/<name>/beans.toml -------------------------------------------
#
# name    = "exampleA"
# prefix  = "exampleA"
# remotes = ["https://github.com/owner/exampleA"]   # normalized remote URLs
#
# [workflow]
# default = "in_progress"

# --- ~/.beans/config.toml (per user, never in the hub) ---------------------
#
# actor = "matt"
#
# [hub]
# remote = "git@github.com:owner/beans-hub.git"   # recorded by bn init
# branch = "main"                                  # recorded by bn init
#
# [fetch]
# throttle = "60s"
